{
  "permissions": {
    "allow": [
      "Bash(go test ./...)",
      "Bash(go test *)",
      "Bash(go build ./...)",
      "Bash(go vet ./...)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(ls)",
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(go mod download)",
      "Bash(go mod tidy)",
      "Bash(go env *)",
      "Bash(which *)",
      "Bash(make *)",
      "Bash(./bin/* *)",
      "Bash(go run *)",
      "Bash(curl *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(docker *)",
      "Bash(wrangler *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/test-runner.sh" },
          { "type": "command", "command": "bash .claude/hooks/kanban-move.sh" }
        ]
      }
    ]
  }
}