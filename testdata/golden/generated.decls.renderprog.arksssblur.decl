{
	newstyle

	options {
	}

	state {
		blend	ONE ONE
		blendOp	ADD
		depthfunc EQUAL
		depthwrite 0
	}

	hlsl_prefix {
		#include <vertex>
		#include <BRDF_skin>			// BRDF model must be included before lighting!
		#include <lighting>
		#include <arkDefaultHelpers>
		#include <materialEffects>
		#include <fogHelpers>

		// billy.khan - this whole algorithm should be refactored - at the bare minimum a billateral
		//				blur should be used to bring the number of taps down.  We ran out of time so we 
		//				are reducing the number of taps down while minimizing the change in look for the consoles
		//				Because we didn't have direct access to the original equation that computes the tap weights, 
		//				we are reusing the original tap weights for the new poisson tap uv offsets.
		//				The difference in look should be marginal.
